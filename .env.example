# Local preview. Copy to .env; never commit .env.
SITE_URL=http://localhost:3000
DEMO_MODE=true
INDEXABLE=false
CANONICAL_REDIRECT=false
PRIVACY_APPROVED=false
# Live CRM: Apps Script Web App URL ending /exec and a shared 32+ character secret.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
# Server-side anti-spam validation is always enforced when NODE_ENV=production.
REQUIRE_TURNSTILE=true
# Additional exact origins for staging; never use a wildcard.
ALLOWED_ORIGINS=
